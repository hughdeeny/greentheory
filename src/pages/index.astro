---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../layouts/PageShell.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import GalleryStrip from '../components/GalleryStrip.astro';
import Contact from '../components/Contact.astro';
import { homeGalleryFieldIntro } from '../lib/home-content';
---

<BaseLayout canonical="/">
  <PageShell>
    <main id="main-content">
      <Hero />
      <GalleryStrip
        indices={[2, 1, 9, 3]}
        title={homeGalleryFieldIntro.title}
        subtitle={homeGalleryFieldIntro.subtitle}
      />
      <Services />
      <Contact />
    </main>
  </PageShell>
</BaseLayout>
