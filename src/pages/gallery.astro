---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../layouts/PageShell.astro';
import { galleryImages } from '../lib/gallery';
import { siteConfig } from '../lib/site';
---

<BaseLayout
  title="Gallery"
  description="Photos of turf, lawns, hedges and gardens from Green Theory projects across Adelaide — specialist outdoor presentation."
  canonical="/gallery"
>
  <PageShell>
    <main id="main-content" class="bg-cream pb-24 pt-28 md:pt-36 lg:pt-40">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <nav class="text-sm text-stone">
          <a href="/" class="font-medium text-forest underline-offset-4 hover:underline">Home</a>
          <span class="mx-2 text-stone/60" aria-hidden="true">/</span>
          <span class="text-charcoal">Gallery</span>
        </nav>

        <header class="mt-8 max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-sage">Project photography</p>
          <h1 class="mt-3 font-display text-4xl font-bold uppercase tracking-tight text-forest sm:text-5xl lg:text-6xl">
            Gallery
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-stone">
            A selection of recent outdoor work — turf, structure, planting and presentation — from{' '}
            {siteConfig.name}'s Adelaide sites. For a scope on your property,{' '}
            <a href="/#contact" class="font-semibold text-forest underline-offset-4 hover:underline">
              get in touch
            </a>
            .
          </p>
        </header>

        <ul class="mt-14 grid list-none gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {
            galleryImages.map((img) => (
              <li class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-cream-dark">
                <figure class="relative m-0">
                  <div class="relative aspect-[4/3] w-full">
                    <img
                      src={img.src}
                      alt={img.alt}
                      class="absolute inset-0 h-full w-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <figcaption class="sr-only">{img.alt}</figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>
    </main>
  </PageShell>
</BaseLayout>
