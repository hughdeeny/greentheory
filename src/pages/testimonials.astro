---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../layouts/PageShell.astro';
import Testimonials from '../components/Testimonials.astro';
import { siteConfig } from '../lib/site';
---

<BaseLayout
  title="Testimonials"
  description="Client reviews and feedback for Green Theory turf and garden care across Adelaide."
  canonical="/testimonials"
>
  <PageShell>
    <main id="main-content" class="bg-cream pb-0 pt-28 md:pt-36 lg:pt-40">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <nav class="text-sm text-stone">
          <a href="/" class="font-medium text-forest underline-offset-4 hover:underline">Home</a>
          <span class="mx-2 text-stone/60" aria-hidden="true">/</span>
          <a href="/about" class="font-medium text-forest underline-offset-4 hover:underline">About Us</a>
          <span class="mx-2 text-stone/60" aria-hidden="true">/</span>
          <span class="text-charcoal">Testimonials</span>
        </nav>

        <header class="mt-8 max-w-3xl pb-4 md:pb-8">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-sage">Client stories</p>
          <h1 class="mt-3 font-display text-4xl font-bold uppercase tracking-tight text-forest sm:text-5xl lg:text-6xl">
            What clients say
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-stone">
            Feedback from clients across Adelaide who work with {siteConfig.name}.
          </p>
        </header>
      </div>

      <Testimonials hideHeader />
    </main>
  </PageShell>
</BaseLayout>
