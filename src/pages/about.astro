---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../layouts/PageShell.astro';
import HowWeWork from '../components/HowWeWork.astro';
import Process from '../components/Process.astro';
import WhoWeWorkWith from '../components/WhoWeWorkWith.astro';
import WhyGreenTheory from '../components/WhyGreenTheory.astro';
import Testimonials from '../components/Testimonials.astro';
import { siteConfig } from '../lib/site';
---

<BaseLayout
  title="About Us"
  description={`${siteConfig.name} — how we work, who we serve, and our process from consultation through ongoing care. ${siteConfig.aboutLead}`}
  canonical="/about"
>
  <PageShell>
    <main id="main-content" class="bg-cream pb-0 pt-28 md:pt-36 lg:pt-40">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <nav class="text-sm text-stone">
          <a href="/" class="font-medium text-forest underline-offset-4 hover:underline">Home</a>
          <span class="mx-2 text-stone/60" aria-hidden="true">/</span>
          <span class="text-charcoal">About Us</span>
        </nav>

        <header class="mt-8 max-w-3xl pb-12 md:pb-16">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-sage">Green Theory</p>
          <h1 class="mt-3 font-display text-4xl font-bold uppercase tracking-tight text-forest sm:text-5xl lg:text-6xl">
            About Us
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-stone">{siteConfig.aboutLead}</p>
        </header>
      </div>

      <WhyGreenTheory />
      <HowWeWork />
      <Process />
      <WhoWeWorkWith />
      <Testimonials />
    </main>
  </PageShell>
</BaseLayout>
