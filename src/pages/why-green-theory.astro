---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../layouts/PageShell.astro';
import WhyGreenTheory from '../components/WhyGreenTheory.astro';
import HowWeWork from '../components/HowWeWork.astro';
import Process from '../components/Process.astro';
import WhoWeWorkWith from '../components/WhoWeWorkWith.astro';
import { siteConfig } from '../lib/site';
---

<BaseLayout
  title="Why Green Theory"
  description={`Why choose ${siteConfig.name}? Specialist turf and garden care, systems behind every visit, and a clear process from consultation through ongoing care across Adelaide.`}
  canonical="/why-green-theory"
>
  <PageShell>
    <main id="main-content" class="bg-cream pb-0 pt-28 md:pt-36 lg:pt-40">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <nav class="text-sm text-stone">
          <a href="/" class="font-medium text-forest underline-offset-4 hover:underline">Home</a>
          <span class="mx-2 text-stone/60" aria-hidden="true">/</span>
          <a href="/about" class="font-medium text-forest underline-offset-4 hover:underline">About Us</a>
          <span class="mx-2 text-stone/60" aria-hidden="true">/</span>
          <span class="text-charcoal">Why Green Theory</span>
        </nav>
      </div>

      <WhyGreenTheory class="pt-8 lg:pt-12" />
      <HowWeWork />
      <Process />
      <WhoWeWorkWith />
    </main>
  </PageShell>
</BaseLayout>
