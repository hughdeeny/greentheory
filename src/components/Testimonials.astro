---
import { testimonials } from '../lib/testimonials';
---

<section class="bg-white py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-sage">Client Stories</p>
      <h2 class="mt-3 font-display text-3xl font-bold uppercase tracking-tight text-forest sm:text-4xl lg:text-5xl">
        What clients say
      </h2>
      <p class="mt-5 text-base leading-relaxed text-stone">
        Feedback from clients across Adelaide.
      </p>
    </div>

    <div class="mx-auto mt-16 grid max-w-5xl gap-8 sm:grid-cols-2">
      {
        testimonials.map((t) => (
          <blockquote class="flex flex-col rounded-2xl border border-cream-dark bg-cream/40 p-8">
            <div class="mb-6 flex gap-1 text-sand" role="img" aria-label="Rated 5 out of 5 stars">
              {Array.from({ length: 5 }).map(() => (
                <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="flex-1 text-[15px] leading-relaxed text-stone">&ldquo;{t.quote}&rdquo;</p>
            <footer class="mt-6 border-t border-cream-dark pt-6">
              <p class="font-semibold text-charcoal">{t.name}</p>
              <p class="text-sm text-stone">{t.location}</p>
            </footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>
