---
const steps = [
  {
    number: '01',
    title: 'Consultation',
    description:
      "We visit your property, assess soil conditions, sun patterns, and discuss your vision, budget, and timeline — whether it's a home garden, commercial frontage or strata common area.",
  },
  {
    number: '02',
    title: 'Custom Plan',
    description:
      'We prepare a detailed proposal with plant selections, materials and a clear scope — so expectations, timing and presentation standards are aligned before work begins.',
  },
  {
    number: '03',
    title: 'Expert Execution',
    description:
      'Our team brings the plan to life with precision workmanship, respecting your property every step of the way.',
  },
  {
    number: '04',
    title: 'Ongoing Care',
    description:
      'Optional maintenance programs keep your investment thriving — seasonal adjustments included as standard.',
  },
];
---

<section
  id="process"
  class="scroll-mt-36 border-y border-white/10 bg-forest py-24 text-cream md:scroll-mt-40 lg:py-32"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-sage-light">How It Works</p>
      <h2 class="mt-3 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
        From first call to flourishing garden
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-cream/75">
        A straightforward process designed around your schedule and your outdoor goals.
      </p>
    </div>

    <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, i) => (
          <div class="relative">
            {i < steps.length - 1 && (
              <div class="absolute right-0 top-8 hidden h-px w-full translate-x-1/2 bg-sage/30 lg:block" aria-hidden="true"></div>
            )}
            <p class="font-display text-5xl font-light text-sage/40">{step.number}</p>
            <h3 class="mt-4 font-display text-xl font-semibold">{step.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-cream/70">{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
