---
import { siteConfig } from '../lib/site';
import SortScapeEmbed from './SortScapeEmbed.astro';

const showSortscape = siteConfig.sortscapeEmbed.enabled;
---

<section id="contact" class="scroll-mt-36 bg-cream py-24 md:scroll-mt-40 lg:py-32">
  <div class="w-full">
    <div class="w-full overflow-hidden border-y border-cream-dark bg-white shadow-sm ring-1 ring-stone-900/5">
      {
        showSortscape ? (
          <>
            <div class="border-b border-cream-dark/70 bg-gradient-to-b from-cream/50 to-cream/20 px-6 py-5 text-center sm:px-8 sm:py-6">
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-sage">Get in Touch</p>
              <h3 class="mt-3 font-display text-3xl font-bold uppercase tracking-tight text-forest sm:text-4xl lg:text-5xl text-balance">
                Enquire about your garden
              </h3>
            </div>
            <SortScapeEmbed />
          </>
        ) : (
          <div class="mx-auto max-w-3xl p-6 sm:p-8 lg:p-10">
            <p class="text-sm text-stone">
              Online request form is not configured. Call{' '}
              <a href={`tel:${siteConfig.phone}`} class="font-medium text-forest underline">
                {siteConfig.phoneDisplay}
              </a>{' '}
              or email{' '}
              <a href={`mailto:${siteConfig.email}`} class="font-medium text-forest underline">
                {siteConfig.email}
              </a>
              .
            </p>
          </div>
        )
      }
    </div>
  </div>

  <div class="mx-auto mt-16 max-w-7xl px-6 lg:px-8">
    <div class="grid gap-6 sm:grid-cols-2 lg:max-w-2xl">
      <a
        href={`tel:${siteConfig.phone}`}
        class="group flex items-center gap-4 rounded-2xl border border-cream-dark bg-white p-5 transition-all hover:border-sage/40 hover:shadow-md"
      >
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-forest/10 text-forest transition-colors group-hover:bg-forest group-hover:text-cream">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"></path>
          </svg>
        </span>
        <div>
          <p class="text-sm text-stone">Phone</p>
          <p class="font-semibold text-charcoal">{siteConfig.phoneDisplay}</p>
        </div>
      </a>

      <a
        href={`mailto:${siteConfig.email}`}
        class="group flex items-center gap-4 rounded-2xl border border-cream-dark bg-white p-5 transition-all hover:border-sage/40 hover:shadow-md"
      >
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-forest/10 text-forest transition-colors group-hover:bg-forest group-hover:text-cream">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"></path>
          </svg>
        </span>
        <div>
          <p class="text-sm text-stone">Email</p>
          <p class="font-semibold text-charcoal">{siteConfig.email}</p>
        </div>
      </a>
    </div>
  </div>
</section>
