---
import { siteConfig } from '../lib/site';
---

<section
  class="relative min-h-screen overflow-hidden"
  aria-label="Green Theory — specialist turf and garden care, Adelaide; diagnosis-led lawn and garden programs"
>
  <img
    src="/images/hero-lawn.jpg"
    alt="Professional lawn care and landscaped garden in Adelaide — Green Theory turf, hedging and garden services"
    class="absolute inset-0 h-full w-full object-cover"
    width={1920}
    height={1080}
    fetchpriority="high"
    decoding="async"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-charcoal/80 via-forest/60 to-charcoal/90"></div>

  <div class="relative mx-auto flex min-h-[100dvh] max-w-7xl flex-col justify-start px-6 pb-16 pt-32 sm:pt-36 md:pt-40 lg:min-h-screen lg:justify-end lg:px-8 lg:pb-28 lg:pt-52 xl:pt-56">
    <div class="max-w-3xl">
      <h1 class="animate-fade-up font-display text-4xl font-black uppercase leading-[1.05] tracking-tight text-white [text-shadow:0_2px_28px_rgba(0,0,0,0.45)] sm:text-5xl lg:text-6xl">
        Turf. Plants. <span class="text-sage-light">Precision.</span>
      </h1>

      <p class="animate-fade-up animation-delay-100 mt-6 max-w-2xl text-base leading-relaxed text-cream/90 sm:mt-8 sm:text-lg">
        Professional lawn, garden and turf care for Adelaide homes that need lasting results, not quick tidy-ups
      </p>
    </div>

    <div class="animate-fade-up animation-delay-200 mt-8 flex max-w-3xl flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center lg:mt-10">
      <a
        href="#contact"
        class="inline-flex items-center justify-center rounded-full bg-cream px-8 py-4 text-base font-semibold text-forest transition-all hover:bg-white hover:shadow-lg"
      >
        Request a Quote
      </a>
      <a
        href={`tel:${siteConfig.phone}`}
        class="inline-flex items-center justify-center rounded-full border border-cream/40 bg-white/5 px-8 py-4 text-base font-semibold text-cream transition-all hover:bg-white/15"
      >
        Call {siteConfig.phoneDisplay}
      </a>
      <a
        href="#services"
        class="inline-flex items-center justify-center gap-2 text-sm font-semibold text-cream/90 underline-offset-4 transition-colors hover:text-cream sm:ml-1 sm:no-underline sm:hover:underline"
      >
        View services
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
