---
import { services } from '../lib/services';
---

<section id="services" class="scroll-mt-36 bg-white py-24 md:scroll-mt-40 lg:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <header class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-sage">Our Services</p>
      <h2 class="mt-3 font-display text-3xl font-bold uppercase tracking-tight text-forest sm:text-4xl lg:text-5xl">
        Programs for turf, lawns &amp; gardens
      </h2>
      <p class="mt-4 text-base leading-relaxed text-stone sm:text-lg">
        Routine visits through full renovations — structured care for homes, strata and commercial sites.
      </p>
    </header>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
      {
        services.map((service) => (
          <article class="group rounded-2xl border border-cream-dark bg-cream/50 p-8 transition-all duration-300 hover:border-sage/40 hover:bg-white hover:shadow-lg hover:shadow-forest/5">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-forest/10 text-forest transition-colors group-hover:bg-forest group-hover:text-cream">
              {service.icon === 'turf' && (
                <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7" aria-hidden="true">
                  <path d="M4 18c2-4 5-6 8-6s6 2 8 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M8 14c1-3 3-5 4-8 1 3 3 5 4 8M12 6c0-2 1-3 2-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              )}
              {service.icon === 'renovation' && (
                <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7" aria-hidden="true">
                  <path d="M4 18c2-4 5-6 8-6s6 2 8 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M7 14h10M9 10h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              )}
              {service.icon === 'hedging' && (
                <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7" aria-hidden="true">
                  <path d="M3 17h18M6 17V11l3-3 3 3v6M12 17V8l3-3 3 3v9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {service.icon === 'irrigation' && (
                <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7" aria-hidden="true">
                  <path d="M12 3c-3 4-6 6-6 9a6 6 0 1012 0c0-3-3-5-6-9z" stroke="currentColor" stroke-width="1.5" />
                  <path d="M9 14c1 1.5 2 2 3 2s2-.5 3-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              )}
              {service.icon === 'landscaping' && (
                <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7" aria-hidden="true">
                  <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" />
                  <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              )}
            </div>
            <h3 class="font-display text-lg font-bold uppercase tracking-wide text-charcoal">
              {service.title}
            </h3>
            <p class="mt-3 text-[15px] leading-relaxed text-stone">{service.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
