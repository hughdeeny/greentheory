---
const renovationSteps = [
  'Scarifying',
  'Coring',
  'Top dressing',
  'Fertilising',
  'Recovery planning',
] as const;
---

<section
  class="scroll-mt-36 bg-forest py-24 text-cream md:scroll-mt-40 lg:py-32"
  aria-labelledby="lawn-renovations-heading"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:items-start lg:gap-16">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-sage-light">Specialist service</p>
        <h2
          id="lawn-renovations-heading"
          class="mt-3 font-display text-3xl font-bold uppercase tracking-tight text-cream sm:text-4xl lg:text-5xl"
        >
          Lawn renovations
        </h2>

        <div class="mt-8 space-y-5 text-[17px] leading-relaxed text-cream/85">
          <p class="text-lg font-medium text-cream">A lawn renovation is much more than laying new turf.</p>
          <p>
            Our renovation programs are designed to restore tired, compacted or weed-affected lawns through services such as scarifying, coring, top dressing, fertilising and recovery planning.
          </p>
          <p>
            The goal is to improve lawn health from the ground up and create a thicker, healthier and more resilient lawn over time.
          </p>
        </div>

        <a
          href="/#contact"
          class="mt-10 inline-flex items-center justify-center rounded-full bg-cream px-8 py-4 text-base font-semibold text-forest transition-all hover:bg-white hover:shadow-lg"
        >
          Discuss a renovation program
        </a>
      </div>

      <aside class="rounded-3xl border border-white/15 bg-white/5 p-8 backdrop-blur-sm">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-sage-light">Typical program elements</p>
        <ul class="mt-6 space-y-4">
          {
            renovationSteps.map((step) => (
              <li class="flex items-center gap-3 text-[15px] font-medium text-cream">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-sage-light/20 text-sage-light">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                  </svg>
                </span>
                {step}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</section>
