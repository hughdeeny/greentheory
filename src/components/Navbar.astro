---
import Logo from './Logo.astro';
import { navLinks, siteConfig } from '../lib/site';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 pt-[max(0px,env(safe-area-inset-top))] shadow-md shadow-black/15 transition-shadow duration-300"
>
  <div class="w-full border-b border-white/10 bg-forest">
    <div class="flex w-full items-center justify-between gap-2 px-3 py-2.5 sm:gap-3 sm:px-5 sm:py-3 lg:px-8 xl:px-12 2xl:px-16">
      <div class="relative z-10 min-w-0 flex-1 overflow-hidden pr-1">
        <Logo showWordmark size="xl" class="group max-w-full md:max-w-none" />
      </div>

      <div class="relative z-20 flex shrink-0 items-center gap-2.5 sm:gap-4">
        <a
          href={`tel:${siteConfig.phone}`}
          class="hidden items-center gap-2.5 text-cream md:inline-flex"
        >
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-cream ring-1 ring-white/15">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
              ></path>
            </svg>
          </span>
          <span class="text-base font-bold tracking-tight text-cream lg:text-lg">{siteConfig.phoneDisplay}</span>
        </a>

        <div class="md:hidden">
          <button
            type="button"
            id="mobile-menu-btn"
            class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/20 bg-white/10 text-cream ring-1 ring-white/15 transition-colors hover:bg-white/15 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream"
            aria-expanded="false"
            aria-controls="mobile-nav-drawer"
            aria-label="Open menu"
          >
            <svg id="menu-open-icon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
            </svg>
            <svg id="menu-close-icon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <a
          href="/#contact"
          class="relative isolate hidden items-center justify-center rounded-lg bg-cream px-3.5 py-2 text-center text-xs font-bold uppercase tracking-wide text-forest shadow-md ring-1 ring-white/20 transition-colors hover:bg-white sm:px-6 sm:py-2.5 sm:text-sm md:inline-flex lg:px-7 lg:py-3 lg:text-base"
        >
          Request a quote
        </a>
      </div>
    </div>
  </div>

  <nav class="hidden w-full border-b border-cream-dark bg-white md:block" aria-label="Primary">
    <ul class="mx-auto flex w-full max-w-none items-stretch px-3 py-1.5 sm:px-5 lg:px-8 xl:px-12 2xl:px-16">
      {
        navLinks.map((link) => (
          <li class="flex min-w-0 flex-1">
            <a
              href={link.href}
              class="flex w-full flex-1 items-center justify-center px-1 py-2 text-center text-[10px] font-semibold uppercase leading-snug tracking-tight text-forest transition-colors hover:bg-cream/80 hover:text-forest sm:px-1.5 sm:text-[11px] lg:text-xs lg:leading-tight xl:text-sm"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<div id="mobile-nav-backdrop" class="fixed inset-0 z-[60] hidden bg-black/50 md:hidden" aria-hidden="true"></div>

<div
  id="mobile-nav-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
  class="fixed inset-y-0 right-0 z-[61] hidden w-[min(100vw,20rem)] flex-col border-l border-white/10 bg-forest shadow-2xl md:hidden"
  style="padding-top: max(0.75rem, env(safe-area-inset-top));"
>
  <div class="flex items-center justify-end border-b border-white/10 px-3 py-2">
    <button
      type="button"
      id="mobile-menu-close"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-cream transition-colors hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream"
      aria-label="Close menu"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <nav class="flex flex-1 flex-col overflow-y-auto px-4 pb-8 pt-4" aria-label="Mobile primary">
    <ul class="space-y-1">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-nav-link block rounded-lg px-3 py-3 text-base font-semibold uppercase tracking-wide text-cream transition-colors hover:bg-white/10"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-6 space-y-3 border-t border-white/10 pt-6">
      <a
        href="/#contact"
        class="mobile-nav-link block rounded-lg bg-cream px-4 py-3 text-center text-sm font-bold uppercase tracking-wide text-forest shadow-md ring-1 ring-white/20 transition-colors hover:bg-white"
      >
        Request a quote
      </a>
      <a
        href={`tel:${siteConfig.phone}`}
        class="flex items-center justify-center gap-2 rounded-lg border border-white/20 px-4 py-3 text-sm font-semibold text-cream transition-colors hover:bg-white/10"
      >
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 ring-1 ring-white/15">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
            ></path>
          </svg>
        </span>
        Call {siteConfig.phoneDisplay}
      </a>
    </div>
  </nav>
</div>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-menu-close');
  const drawer = document.getElementById('mobile-nav-drawer');
  const backdrop = document.getElementById('mobile-nav-backdrop');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  function setScrolled() {
    if (!header) return;
    const scrolled = window.scrollY > 40;
    header.classList.toggle('shadow-lg', scrolled);
    header.classList.toggle('shadow-black/25', scrolled);
    header.classList.toggle('shadow-md', !scrolled);
    header.classList.toggle('shadow-black/15', !scrolled);
  }

  function setMenuOpen(open: boolean) {
    if (!btn || !drawer || !backdrop || !openIcon || !closeIcon) return;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    drawer.classList.toggle('hidden', !open);
    drawer.classList.toggle('flex', open);
    backdrop.classList.toggle('hidden', !open);
    openIcon.classList.toggle('hidden', open);
    closeIcon.classList.toggle('hidden', !open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }

  window.addEventListener('scroll', setScrolled, { passive: true });
  setScrolled();

  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!open);
  });

  closeBtn?.addEventListener('click', () => setMenuOpen(false));
  backdrop?.addEventListener('click', () => setMenuOpen(false));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenuOpen(false);
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
</script>
