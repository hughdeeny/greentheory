---
import { galleryImages } from '../lib/gallery';

interface Props {
  indices: readonly number[];
  eyebrow?: string;
  title: string;
  subtitle?: string;
}

const { indices, eyebrow = 'From the field', title, subtitle } = Astro.props;
const images = indices.map((i) => galleryImages[i]).filter(Boolean);
const stripId = `gallery-strip-${indices.join('-')}`;
---

<section class="border-y border-cream-dark bg-white pt-14 pb-0 lg:pt-20 lg:pb-0" aria-labelledby={stripId}>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <div>
        {eyebrow ? (
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-sage">{eyebrow}</p>
        ) : null}
        <h2
          id={stripId}
          class={`font-display text-2xl font-bold uppercase tracking-tight text-forest sm:text-3xl ${eyebrow ? 'mt-2' : ''}`}
        >
          {title}
        </h2>
        {subtitle ? (
          <p class="mt-3 max-w-xl text-[15px] leading-relaxed text-stone">{subtitle}</p>
        ) : null}
      </div>
      <a
        href="/gallery"
        class="shrink-0 self-start rounded-full border border-forest/20 bg-cream/60 px-5 py-2.5 text-sm font-semibold text-forest transition-colors hover:border-forest/40 hover:bg-cream sm:self-auto"
      >
        Full gallery
      </a>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        images.map((img) => (
          <a
            href="/gallery"
            class="group relative aspect-[4/3] overflow-hidden rounded-2xl bg-cream-dark ring-1 ring-cream-dark transition-shadow hover:shadow-lg hover:ring-sage/30"
          >
            <img
              src={img.src}
              alt={img.alt}
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>
